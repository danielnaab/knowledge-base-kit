# What `git archive` exports. graft v2.13.0 and later read the whole repository (a git submodule at a release
# tag) and ignore these lines; they stay for `git archive` users: README, CHANGELOG, docs/, adapters/,
# examples/, and src/ (the checker).
/.gitattributes      export-ignore
/.gitignore          export-ignore
/AGENTS.md           export-ignore
/knowledge-base.yaml export-ignore
/notes/              export-ignore
/.claude/            export-ignore
/.forgejo/           export-ignore
/.python-version     export-ignore
/flake.lock          export-ignore
/flake.nix           export-ignore
/pyproject.toml      export-ignore
/scions/             export-ignore
/specs/              export-ignore
/tests/              export-ignore
/uv.lock             export-ignore
