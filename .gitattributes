# What this repository exports. Repos that graft it (https://github.com/danielnaab/graft/tree/v2)
# get the tagged release minus the paths below: README, CHANGELOG, docs/, adapters/, examples/, and
# src/ (the checker, read by consumers as ${inputs.knowledge-base-kit}/src).
/.gitattributes      export-ignore
/.gitignore          export-ignore
/AGENTS.md           export-ignore
/knowledge-base.yaml export-ignore
/notes/              export-ignore
/.claude/            export-ignore
/.forgejo/           export-ignore
/.python-version     export-ignore
/flake.lock          export-ignore
/flake.nix           export-ignore
/pyproject.toml      export-ignore
/scions/             export-ignore
/specs/              export-ignore
/tests/              export-ignore
/uv.lock             export-ignore
